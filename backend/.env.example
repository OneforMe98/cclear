# 把本文件复制为 .env 后填入真实值（.env 不会被提交到 git）
# 去 https://platform.deepseek.com 创建 API Key
DEEPSEEK_API_KEY=sk-你的密钥

# 以下两项一般不用改
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat

# ---- 以下为可选高级配置，一般无需填写（取消注释才会生效）----
# 采样温度（0~1，越低越稳定保守；清理建议类任务默认 0.3 比较合适）
# MODEL_TEMPERATURE=0.3

# Agent 单次任务最大步数（模型思考 + 调工具都算一步，默认 12）
# AGENT_MAX_STEPS=12

# 对话记忆数据库路径（默认 backend/data/cclear.db）。想重置所有对话可删除该文件。
# CHECKPOINT_DB=D:\some\path\cclear.db

# 用户画像（跨会话长期偏好）数据库路径（默认 backend/data/profile.db）
# PROFILE_DB=D:\some\path\profile.db

# 当前用户标识（默认 local）。单机自用不用改；将来做多用户时从登录信息注入。
# PROFILE_USER_ID=local

# ---- 上下文压缩（记忆压缩）----
# 完整保留最近几轮对话；更早的轮次只保留"用户问题 + 最终结论"（省 token）
# COMPACT_KEEP_TURNS=4
# 单条工具输出的字符上限，超过截断（防止一次列出 100 条长路径灌爆上下文）
# COMPACT_MAX_TOOL_CHARS=1500
# 压缩开关（设 0 可关闭，用于对比行为差异）
# COMPACT_ENABLED=1

# SSE 心跳间隔（秒，默认 10）。长时间无输出时多久发一次保活注释。
# HEARTBEAT_SECONDS=10
